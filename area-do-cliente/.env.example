# Porta do servidor
PORT=3000
# Onde ficam o banco, as fotos e os vídeos (padrão: area-do-cliente/data). No Railway: /data (volume).
PASTA_DADOS=data
# Chave da API do Claude (console.anthropic.com). Sem ela: estratégia no modelo pronto e análise simples.
ANTHROPIC_API_KEY=
# Primeiro acesso da equipe VGA (criado ao iniciar, se ainda não existir).
ADMIN_EMAIL=
ADMIN_SENHA=
# Tamanho máximo de cada envio (MB)
MAX_FOTO_MB=25
MAX_VIDEO_MB=300
# 0 desliga a atualização semanal automática pela IA
ATUALIZACAO_AUTOMATICA=1
